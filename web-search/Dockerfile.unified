FROM node:22.13-alpine AS web-dependencies
WORKDIR /workspace/web-search
COPY web-search/package.json web-search/package-lock.json ./
RUN npm install --global npm@11.12.1 \
    && npm ci

FROM node:22.13-alpine AS web-builder
WORKDIR /workspace/web-search

ARG NUXT_PUBLIC_BASE_URL=/api
ARG NUXT_PUBLIC_ORDER_URL=/admin/order
ARG NUXT_PUBLIC_LOGIN_URL=/admin/login
ARG NUXT_PUBLIC_WSS_URL=wss://chat.co-logistics.cn/wss
ARG NUXT_PUBLIC_MALL_BASE_URL=/mall-api
ARG NUXT_PUBLIC_SEARCH_BASE_URL=/search-api
ARG NUXT_PUBLIC_NEW_USER_SHIPPING_COUPON_ENABLED=false

ENV NODE_ENV=production \
    NUXT_PUBLIC_BASE_URL=${NUXT_PUBLIC_BASE_URL} \
    NUXT_PUBLIC_ORDER_URL=${NUXT_PUBLIC_ORDER_URL} \
    NUXT_PUBLIC_LOGIN_URL=${NUXT_PUBLIC_LOGIN_URL} \
    NUXT_PUBLIC_WSS_URL=${NUXT_PUBLIC_WSS_URL} \
    NUXT_PUBLIC_MALL_BASE_URL=${NUXT_PUBLIC_MALL_BASE_URL} \
    NUXT_PUBLIC_SEARCH_BASE_URL=${NUXT_PUBLIC_SEARCH_BASE_URL} \
    NUXT_PUBLIC_NEW_USER_SHIPPING_COUPON_ENABLED=${NUXT_PUBLIC_NEW_USER_SHIPPING_COUPON_ENABLED}

COPY --from=web-dependencies /workspace/web-search/node_modules ./node_modules
COPY web-search/ ./
COPY member-center/src/ /workspace/member-center/src/
RUN npm run build

FROM node:22.13-alpine AS runtime
WORKDIR /app/web

ENV NODE_ENV=production \
    HOST=127.0.0.1 \
    PORT=3000 \
    NITRO_HOST=127.0.0.1 \
    NITRO_PORT=3000 \
    COD_UPSTREAM_HOST=codropshipping.com \
    COD_MALL_UPSTREAM_HOST=v2.cargosoon.online

RUN apk add --no-cache gettext nginx su-exec tini wget

COPY --from=web-builder --chown=node:node /workspace/web-search/.output ./.output
COPY web-search/docker/unified/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY web-search/docker/unified/entrypoint.sh /usr/local/bin/codropshipping-ui

RUN chmod 755 /usr/local/bin/codropshipping-ui \
    && mkdir -p /run/nginx /var/cache/nginx

EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=6s --start-period=25s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null \
    && wget -qO- http://127.0.0.1:8080/admin/main/dashboard >/dev/null \
    || exit 1

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/codropshipping-ui"]
