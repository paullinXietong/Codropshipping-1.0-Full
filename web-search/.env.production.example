# Public hostname served by Caddy.
COD_PUBLIC_HOST=codropshipping.example.com

# Immutable release and image names used by Docker Compose.
COD_RELEASE_TAG=1.0.0
COD_WEB_IMAGE=codropshipping/web
COD_MEMBER_IMAGE=codropshipping/member-center
COD_LISTING_IMAGE=codropshipping/listing-api
COD_SEARCH_IMAGE=codropshipping/search-api

# Existing CoD upstream APIs.
COD_API_BASE_URL=https://codropshipping.com/api
COD_IDENTITY_PATH=/customer/api/user/home/info
COD_UPSTREAM_HOST=codropshipping.com
COD_MALL_UPSTREAM_HOST=v2.cargosoon.online

# Search database and protected administration endpoint.
SEARCH_DB_HOST=cargosoon-production-mysql-1
SEARCH_DB_PORT=3306
SEARCH_DB_NAME=cargosoon
SEARCH_DB_USER=product_search
SEARCH_DB_PASSWORD=replace-with-server-secret
SEARCH_ADMIN_TOKEN=replace-with-long-random-token
SEARCH_DB_NETWORK=cargosoon-production_default

# Qwen credentials. Rotate any credentials previously shared outside the
# server secret manager before deploying.
QWEN_API_KEY=replace-with-rotated-server-secret
QWEN_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_NATIVE_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_IMAGE_MODEL=qwen-image-2.0-pro

# Browser origins allowed to call the orchestrator directly. Normal browser
# traffic is same-origin through Caddy, but this remains an explicit defense.
LISTING_ALLOWED_ORIGINS=https://codropshipping.example.com
PUBLIC_TRANSLATION_RATE_LIMIT_PER_MINUTE=30

# Optional resource and index tuning.
SEARCH_MAX_ACTIVE_QUERY_JOBS=1
SEARCH_MAX_INDEX_PRODUCTS=2000
SEARCH_PUBLIC_RATE_LIMIT_PER_MINUTE=90
