{$COD_PUBLIC_HOST} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy member-center:8080
	}

	handle_path /listing-api/* {
		reverse_proxy listing-api:8789
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy https://{$COD_UPSTREAM_HOST} {
			header_up Host {$COD_UPSTREAM_HOST}
			transport http {
				tls_server_name {$COD_UPSTREAM_HOST}
			}
		}
	}

	handle_path /mall-api/* {
		reverse_proxy https://{$COD_MALL_UPSTREAM_HOST} {
			header_up Host {$COD_MALL_UPSTREAM_HOST}
			transport http {
				tls_server_name {$COD_MALL_UPSTREAM_HOST}
			}
		}
	}

	handle_path /search-api/* {
		reverse_proxy search-api:8788
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
